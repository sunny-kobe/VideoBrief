{
  "name": "videobrief",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "docs:check": "node scripts/check-agent-docs.mjs",
    "signals:scan": "tsx scripts/scan-daily-signals.ts",
    "signals:approve": "tsx scripts/approve-daily-signal.ts",
    "signals:enrich": "tsx scripts/enrich-daily-signal.ts",
    "project:produce": "tsx scripts/produce-project.ts",
    "project:workflow": "tsx scripts/run-production-workflow.ts",
    "project:publish": "tsx scripts/publish-project.ts",
    "project:publication-ledger": "tsx scripts/collect-publication-metrics.ts",
    "project:context": "node scripts/project-stage-context.mjs",
    "project:production-report": "node scripts/report-production-run.mjs",
    "transcription:setup": "node scripts/setup-local-whisper.mjs",
    "video:studio": "remotion studio remotion/index.ts",
    "video:still": "mkdir -p output/videos && remotion still remotion/index.ts WeeklyAiShort output/videos/weekly-ai-cover.png --frame=0",
    "video:render": "mkdir -p output/videos && remotion render remotion/index.ts WeeklyAiShort output/videos/weekly-ai-short.mp4 --codec=h264 --pixel-format=yuv420p",
    "video:render:remotion-project": "node scripts/render-remotion-project.mjs",
    "video:review:prepare": "node scripts/build-review-work-package.mjs",
    "video:review:semantic": "node scripts/review-video-semantics.mjs",
    "video:preflight:voiceover": "node scripts/export-production.mjs --stage=voiceover-preflight",
    "video:review:materials": "node scripts/review-material-quality.mjs",
    "video:review:browser": "node scripts/verify-video-browser.mjs",
    "video:package:production": "node scripts/build-export-package.mjs",
    "video:source:information-layer": "tsx scripts/generate-scene-information-layer.ts",
    "video:creative-shot": "node scripts/creative-shot.mjs",
    "video:postprocess": "node scripts/postprocess-video.mjs",
    "video:publish-preview": "mkdir -p public/renders && cp output/videos/weekly-ai-short-final.mp4 public/renders/weekly-ai-short-final.mp4 && cp output/videos/weekly-ai-cover.png public/renders/weekly-ai-cover.png",
    "audio:voiceover": "node scripts/generate-voiceover.mjs",
    "video:check-assets": "node scripts/validate-source-clips.mjs",
    "video:check-assets:production": "node scripts/validate-source-clips.mjs --strict",
    "video:proof": "node scripts/proof-video.mjs --manifest=output/videos/codex-app-explainer-work/render-manifest.json",
    "video:export": "node scripts/export-production.mjs",
    "video:export:review": "node scripts/export-production.mjs",
    "video:export:production": "node scripts/export-production.mjs",
    "video:export:legacy": "npm run audio:voiceover && npm run video:check-assets:production && npm run video:render && npm run video:still && npm run video:postprocess && npm run video:publish-preview",
    "source-clips:placeholder": "node scripts/generate-placeholder-clips.mjs",
    "source-clips:excerpt": "node scripts/prepare-source-excerpt.mjs",
    "source-clips:smooth-source": "node scripts/prepare-smooth-source.mjs",
    "experiment:html-video:doctor": "PATH=\"$PWD/scripts/hyperframes-ffmpeg:$PATH\" npx hyperframes@0.7.39 doctor",
    "experiment:html-video:lint": "npx hyperframes@0.7.39 lint experiments/html-video",
    "experiment:html-video:validate": "npx hyperframes@0.7.39 validate experiments/html-video",
    "experiment:html-video:inspect": "npx hyperframes@0.7.39 inspect experiments/html-video --json --at 0,4,8,11",
    "experiment:html-video:check": "npm run experiment:html-video:lint && npm run experiment:html-video:validate && npm run experiment:html-video:inspect",
    "experiment:html-video:snapshot": "npx hyperframes@0.7.39 snapshot experiments/html-video -o output/experiments/html-video/snapshots --at 0,4,8,11 --no-end",
    "experiment:html-video:render": "mkdir -p output/experiments/html-video && PATH=\"$PWD/scripts/hyperframes-ffmpeg:$PATH\" npx hyperframes@0.7.39 render experiments/html-video --output output/experiments/html-video/weekly-ai-card.mp4 --fps 30 --quality draft --workers 2",
    "benchmark:external:payloads": "node scripts/external-video-benchmark.mjs",
    "benchmark:external:creatomate": "node scripts/external-video-benchmark.mjs --submit=creatomate",
    "benchmark:external:shotstack": "node scripts/external-video-benchmark.mjs --submit=shotstack",
    "video:render:local": "node scripts/render-local-short-video.mjs",
    "video:render:local:synced": "node scripts/render-local-short-video-synced.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.486",
    "@remotion/renderer": "^4.0.486",
    "cheerio": "^1.1.2",
    "edge-tts-universal": "^1.4.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.2.6",
    "openai": "^6.46.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "remotion": "^4.0.486",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2"
  }
}
