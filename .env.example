# External video-render benchmarks. Cloud renderers must fetch media from
# public HTTPS URLs; 127.0.0.1/localhost will not work.
# PUBLIC_ASSET_BASE_URL=https://your-public-assets.example.com
# CREATOMATE_API_KEY=
# SHOTSTACK_API_KEY=
# SHOTSTACK_API_BASE=https://api.shotstack.io/edit/v1
